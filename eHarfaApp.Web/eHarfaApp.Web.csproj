<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MudBlazor" Version="9.0.0-preview.1" />
        <ProjectReference Include="..\eHarfaApp.Web.Client\eHarfaApp.Web.Client.csproj"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.9"/>
    </ItemGroup>

    <ItemGroup Condition="'$(ApplicationEnvironment)'=='Debug'">
        <EmbeddedResource Include="appSettings.Development.json" />
        <Content Remove="appsettings.Development.json" />
        <EmbeddedResource Include="appsettings.Development.json" />
        <Content Remove="appsettings.Production.json" />
        <EmbeddedResource Include="appsettings.Production.json" />
    </ItemGroup>
    <ItemGroup Condition="'$(ApplicationEnvironment)'=='Release'">
        <EmbeddedResource Include="appsettings.Production.json" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="appSettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </EmbeddedResource>
        <EmbeddedResource Condition="'$(Configuration)|$(ApplicationEnvironment)'=='Debug|'" Include="appSettings-*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </EmbeddedResource>
    </ItemGroup>
</Project>