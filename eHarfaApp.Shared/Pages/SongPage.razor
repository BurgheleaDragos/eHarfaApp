@page "/song/{id}"

<section>
    <PageTitle>@Song?.Title</PageTitle>
    <SectionContent SectionName="page-title">@Song?.Title</SectionContent>
    
    <MudStack AlignItems="AlignItems.Start">
        <MudText Typo="Typo.h6" Class="scale pt-4" Align="Align.Left">
            @Song?.Scale
        </MudText>
        <MudText
            Align="Align.Left"
            Class="content py-4 mx-3"
            Style="margin-bottom:0px;"
            Typo="Typo.body1">
            @((MarkupString)Song?.Content!)
        </MudText>
        <MudDivider />
        <MudFabMenu 
            Fixed="true"
            StartIcon="@Icons.Material.Outlined.AddCircleOutline" 
            Color="Color.Primary" 
            DampenItemsBackgroundColor="true" 
            UseCloseIcon="false" 
            Size="Size.Large"
            Style="bottom: 100px;"
            >
            <MudFabMenuItem EndIcon="@Icons.Material.Outlined.Favorite" Color="Color.Primary" Size="Size.Large" OnClick="AddToFavourites"/>
            <MudFabMenuItem EndIcon="@Icons.Material.Outlined.ImportExport" Color="Color.Primary" Size="Size.Large" OnClick="ExportPDF" />
            <MudFabMenuItem EndIcon="@Icons.Material.Outlined.Share" Color="Color.Primary" Size="Size.Large" OnClick="ShareSong" />
        </MudFabMenu>
    </MudStack>
</section>