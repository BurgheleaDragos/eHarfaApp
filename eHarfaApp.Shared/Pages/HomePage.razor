@page "/"
@using eHarfaApp.Shared.Services
@inject IFormFactor FormFactor

<section>
    <PageTitle>@PageTitle</PageTitle>
    <SectionContent SectionName="page-title">@PageTitle</SectionContent>

    <MudContainer >
        <MudTextField
            T="string"
            bind-Value="Search"
            Label="Cautare"
            Adornment="Adornment.End"
            AdornmentIcon="@Icons.Material.Outlined.Search" />
        <MudSwipeArea OnSwipeEnd="HandleSwipe" Style="width: 100%;">
            <MudTabs
                Outlined="false"
                ApplyEffectsToContainer="true"
                Class="mt-2"
                TabPanelsClass="py-0"
                Style="height:75vh;"
                Border="false"
                Centered="true"
                MinimumTabWidth="160px"
                @bind-ActivePanelIndex="SelectedCategory"
                Position="Position.Bottom"
            >
                @foreach (var category in Categories)
                {
                    <MudTabPanel ID="@category.Id" Icon="@category.Icon" >
                        <MudPaper Style="max-height: calc(100vh - 300px);" Class="d-flex align-start overflow-x-auto">
                            <MudList
                                T="string"
                                SelectedValueChanged="SelectSong"
                                Class="align-start full-w2idth"
                                Padding="true"
                                Color="Color.Info">
                                <Virtualize Items="GetSongsForPanel(category.Id)" Context="song" OverscanCount="20">
                                    <MudListItem
                                        T="string"
                                        Text="@GetSongDisplayText(category.Id, song)"
                                        Value="@song.Id">
                                    </MudListItem>
                                </Virtualize>
                            </MudList>
                        </MudPaper>
                    </MudTabPanel>
                }
            </MudTabs>
        </MudSwipeArea>
    </MudContainer>
</section>