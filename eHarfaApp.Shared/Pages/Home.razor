@page "/"
@using eHarfaApp.Shared.Services
@inject IFormFactor FormFactor

<section>
    <PageTitle>Home</PageTitle>
    <SectionContent SectionName="page-title">Home</SectionContent>

    <MudContainer>
        <MudTextField
            T="string"
            bind-Value="Search"
            Label="Cautare"
            Adornment="Adornment.Start"
            AdornmentIcon="@Icons.Material.Outlined.Search" F></MudTextField>
        <MudTabs
            Outlined="true"
            ApplyEffectsToContainer="true"
            Class="mt-8"
            TabPanelsClass="pa-6 pb-8"
            Style="height:75vh;"
            Border="true"
            Centered="true"
            PrevIcon="@Icons.Material.Filled.SkipPrevious"
            NextIcon="@Icons.Material.Filled.SkipNext"
            Position="Position.Bottom"
        >
            @foreach (var category in Categories)
            {
                <MudTabPanel ID="@category.Id" Icon="@category.Icon">@category.Content</MudTabPanel>
            }
        </MudTabs>
    </MudContainer>
</section>