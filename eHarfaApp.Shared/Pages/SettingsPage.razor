@page "/settings"
@using System.Globalization
@using Color = MudBlazor.Color

<section>
    <PageTitle>Setari</PageTitle>
    <SectionContent SectionName="page-title">Setari</SectionContent>

        <MudStack Spacing="3" Class="settings-page ma-4">
            <MudStack Spacing="1">
                <MudText Class="settings-label" Typo="Typo.body1">
                    Dimensiune font:
                </MudText>
                <MudNumericField
                    T="int"
                    Min="10"
                    Max="30"
                    Step="1"
                    FullWidth="true"
                    Typo="Typo.body1"
                    Variant="Variant.Text"
                    Value="@_settings.FontSize"
                    ValueChanged="OnFontSizeChanged" />
            </MudStack>

            <MudStack Spacing="1">
                <MudText Class="settings-label" Typo="Typo.body1">
                    Familie font:
                </MudText>
                <MudSelect
                    T="string"
                    FullWidth="true"
                    Value="@_settings.FontFamily"
                    ValueChanged="OnFontFamilyChanged">
                    @foreach (var family in _fontFamilies)
                    {
                        <MudSelectItem Value="@family" Style="@($"font-family: '{family}', sans-serif;")">@family</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            <MudStack Spacing="1">
                <MudText Class="settings-label" Typo="Typo.body1">
                    Contact:
                </MudText>
                <MudText Typo="Typo.body2" Style="word-break: break-word;">@_settings?.Contact</MudText>
            </MudStack>

            <MudStack Spacing="1">
                <MudText 
                    Class="settings-label"
                    Typo="Typo.body1">
                    Mod noapte
                </MudText>
                <MudToggleGroup
                    T="bool"
                    SelectionMode="SelectionMode.SingleSelection"
                    @bind-Value="@NightMode"
                    FixedContent="false"
                    CheckMark="false"
                    Color="Color.Primary"
                    Class="settings-control">
                    <MudToggleItem Value="@true" Text="Noapte" />
                    <MudToggleItem Value="@false" Text="Zi" />
                </MudToggleGroup>
            </MudStack>
            
            <MudStack Spacing="1">
                <MudText Class="settings-label" Typo="Typo.body1">
                    Sincronizare cantari:
                </MudText>
                <MudStack Class="settings-control">
                    <MudButton Color="Color.Info" Variant="Variant.Filled" OnClick="SyncData" Disabled="@_isSynchronizing">
                        @(_isSynchronizing ? "Se sincronizează..." : "Start")
                    </MudButton>
                    <MudText Typo="Typo.body2" Style="word-break: break-word;">
                        Data ultima sincronizare: <b>@_settings?.LastSynchronized.ToString(CultureInfo.CurrentCulture)</b>
                    </MudText>
                </MudStack>
            </MudStack>
        </MudStack>
</section>
