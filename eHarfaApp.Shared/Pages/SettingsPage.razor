@page "/settings"
@using System.Globalization
@using Color = MudBlazor.Color

<section>
    <PageTitle>Setari</PageTitle>
    <SectionContent SectionName="page-title">Setari</SectionContent>

        <MudGrid Class="d-flex flex-1 flex-column gap-2 ma-2" >
            <MudItem Class="d-flex flex-1 justify-space-between gap-2" xs="10">
                <MudText Class="mud-width-full" Typo="Typo.body1">
                    Dimensiune font:
                </MudText>
                <MudNumericField
                    T="int"
                    Min="10"
                    Max="30"
                    Step="1"
                    FullWidth="true"
                    Typo="Typo.body1"
                    Variant="Variant.Text"
                    @bind-Value="@_settings.FontSize">
                    @_settings?.FontSize
                </MudNumericField>
            </MudItem>

            <MudItem Class="d-flex flex-1 justify-space-between gap-2" xs="10">
                <MudText Class="mud-width-full" Typo="Typo.body1">
                    Familie font:
                </MudText>
                <MudSelect
                    T="string"
                    FullWidth="true"
                    bind-Value="@_settings?.FontFamily">
                    @foreach (var family in _fontFamilies)
                    {
                        <MudSelectItem Value="family">@family</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem Class="d-flex flex-1 justify-space-between gap-2" xs="10">
                <MudText Class="mud-width-full" Typo="Typo.body1">
                    Contact:
                </MudText>
                <MudContainer Class="mud-width-full">@_settings?.Contact</MudContainer>
            </MudItem>

            <MudItem Class="d-flex flex-1 justify-space-between d-inline gap-2" xs="10">
                <MudText 
                    Class="mud-width-full" 
                    Typo="Typo.body1">
                    Mod noapte
                </MudText>
                <MudToggleGroup
                    T="bool"
                    SelectionMode="SelectionMode.SingleSelection"
                    @bind-Value="@NightMode"
                    FixedContent="false"
                    CheckMark="false"
                    Color="Color.Primary"
                    Class="mud-width-full">
                    <MudToggleItem Value="@true" Text="Noapte" />
                    <MudToggleItem Value="@false" Text="Zi" />
                </MudToggleGroup>
            </MudItem>
            
            <MudItem Class="d-flex flex-1 justify-space-between d-block-flex gap-2" xs="10">
                <MudContainer Class="d-inline-flex px-0">
                    <MudText Class="mud-width-full" Typo="Typo.body1">
                        Sincronizare cantari:
                    </MudText>
                    <MudButton Color="Color.Info" Variant="Variant.Filled" OnClick="SyncData">
                        Start
                    </MudButton>
                </MudContainer>
                <MudContainer Class="d-inline-flex px-0 ml-2">
                    Data ultima sincronizare: <b>@_settings?.LastSynchronized.ToString(CultureInfo.CurrentCulture)</b>
                </MudContainer>
            </MudItem>
        </MudGrid>
</section>