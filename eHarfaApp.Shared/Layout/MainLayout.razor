@inherits LayoutComponentBase

<style>
    html { font-size: @(_settings?.FontSize ?? 20)px; }
</style>

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="@_isDarkMode" @ref="_mudThemeProvider"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<section class="page">
    <MudLayout Class="main">
        <MudAppBar Elevation="1" Class="pt-safe-area-inset-top z-index-9999">
            <MudIconButton
                Icon="@Icons.Material.Outlined.ArrowBackIosNew"
                Disabled="_disableBackBtn"
                aria-label="Înapoi"
                OnClick="NavigateBackAsync" />
            <MudSpacer/>
            <MudText Class="title">
                <SectionOutlet SectionName="page-title"/>
            </MudText>
            <MudSpacer/>
            <MudIconButton
                Icon="@Icons.Material.Outlined.Menu"
                Color="Color.Inherit"
                Edge="Edge.Start"
                OnClick="@((e) => DrawerToggle())"/>
        </MudAppBar>
        <MudDrawer @bind-Open="@_drawerOpen" Class="sidebar" Anchor="Anchor.End">
            <NavMenu/>
        </MudDrawer>
        <CascadingValue Name="DarkMode" Value="@_isDarkMode">
            <CascadingValue Name="DarkModeChanged" Value="@OnDarkModeChangedFromSettings">
                <MudMainContent Class="main pt-safe-area-inset-top">
                    @Body
                </MudMainContent>
            </CascadingValue>
        </CascadingValue>
    </MudLayout>
</section>
