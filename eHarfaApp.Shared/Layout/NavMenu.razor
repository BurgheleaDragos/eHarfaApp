<MudNavMenu Bordered="false" Class="d-flex align-content-space-start flex-wrap flex-grow-1 my-4">
    <MudContainer>
        <MudNavLink
            Href="/"
            Match="NavLinkMatch.All"
            IconColor="Color.Primary"
            Icon="@Icons.Material.Outlined.Home">Acasa</MudNavLink>
        <MudNavLink
            Href="/settings"
            Match="NavLinkMatch.Prefix"
            IconColor="Color.Primary"
            Icon="@Icons.Material.Outlined.Settings">Setari</MudNavLink>
        <MudNavLink
            Href="/song/123"
            Match="NavLinkMatch.Prefix"
            IconColor="Color.Primary"
            Icon="@Icons.Material.Outlined.Soap">Song 123</MudNavLink>
    </MudContainer>
    <MudSwitch @bind-Value="@IsDarkMode" Label="Mod noapte" Class="mx-4"/>
</MudNavMenu>


@code
{
    private bool _isDarkMode;
    
    [Parameter]
    public bool IsDarkMode
    {
        get => _isDarkMode;
        set
        {
            if (_isDarkMode == value) return;
            _isDarkMode = value;
            IsDarkModeChanged.InvokeAsync(value);
        }
    }

    [Parameter]
    public EventCallback<bool> IsDarkModeChanged { get; set; }   
    
}